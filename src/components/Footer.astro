---
/**
 * Footer Component
 * Monochrome aesthetic matching the design token system
 */
---

<footer class="site-footer">
	<div class="container flow-large" style="--space: 2.5rem;">
		<div class="repel" style="--gutter: 2rem; align-items: flex-start;">
			<div class="flow" style="--space: 0.5rem; max-width: 32ch;">
				<div class="cluster" style="--gutter: 0.5rem; align-items: center;">
					<svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
						<rect width="32" height="32" rx="6" fill="var(--text)" />
						<path d="M8 24V8L16 20L24 8V24" stroke="var(--background)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<span class="fs-step-1" style="font-weight: 800;">Animancy</span>
				</div>
				<p class="fs-step-00" style="opacity: 0.75;">
					A modern Astro website starter template with fluid design tokens, Vue 3, and Pinia. Inspired by manga art and monochrome design.
				</p>
			</div>

			<div class="cluster" style="--gutter: 3rem; align-items: flex-start;">
				<div class="flow" style="--space: 0.5rem;">
					<h4 class="fs-step-0" style="font-weight: 700;">Navigation</h4>
					<ul role="list" class="flow" style="--space: 0.25rem;">
						<li><a href="/#featured" class="footer-link fs-step-00">Featured</a></li>
						<li><a href="/#collections" class="footer-link fs-step-00">Collections</a></li>
						<li><a href="/#articles" class="footer-link fs-step-00">Essays</a></li>
						<li><a href="/#vue-demo" class="footer-link fs-step-00">Vue Island</a></li>
					</ul>
				</div>

				<div class="flow" style="--space: 0.5rem;">
					<h4 class="fs-step-0" style="font-weight: 700;">Resources</h4>
					<ul role="list" class="flow" style="--space: 0.25rem;">
						<li><a href="/demo/design-system" class="footer-link fs-step-00">Design Tokens</a></li>
						<li><a href="/demo/grid-demo" class="footer-link fs-step-00">Grid Layouts</a></li>
						<li><a href="/demo/flex-grid-demo" class="footer-link fs-step-00">Flex Grid Demo</a></li>
						<li><a href="https://astro.build" target="_blank" rel="noopener" class="footer-link fs-step-00">Astro Docs</a></li>
					</ul>
				</div>
			</div>
		</div>

		<div class="repel footer-bottom" style="--gutter: 1rem; align-items: center;">
			<p class="fs-step-00" style="opacity: 0.6; margin: 0;">
				&copy; {new Date().getFullYear()} Studio Eien. All rights reserved.
			</p>
			<div class="cluster" style="--gutter: 1rem;">
				<span class="tag" style="font-size: 0.75rem;">Astro 5</span>
				<span class="tag" style="font-size: 0.75rem;">Vue 3</span>
				<span class="tag" style="font-size: 0.75rem;">Pinia</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 5rem;
		padding-block: 3rem 2rem;
		border-top: 1px solid var(--border-weak);
		background: var(--background);
	}

	.footer-link {
		text-decoration: none;
		color: var(--text);
		opacity: 0.75;
		transition: opacity 0.2s ease;
	}

	.footer-link:hover {
		opacity: 1;
	}

	.footer-bottom {
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-weak);
	}
</style>
