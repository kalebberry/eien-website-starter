---
/**
 * Footer Component
 * Monochrome aesthetic matching the design token system
 */
---

<footer class="site-footer">
	<div class="container flow-large footer-content">
		<div class="repel footer-main">
			<div class="flow footer-brand">
				<div class="cluster footer-brand__logo-cluster">
					<svg
						width="24"
						height="24"
						viewBox="0 0 32 32"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
					>
						<rect width="32" height="32" rx="6" fill="var(--text)"></rect>
						<path
							d="M8 24V8L16 20L24 8V24"
							stroke="var(--background)"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					<span class="fs-step-1 footer-brand__name">Studio Eien</span>
				</div>
				<p class="fs-step-00 footer-brand__desc">
					A modern Astro website starter template with fluid design
					tokens, Vue 3, and Pinia. Inspired by manga art and
					monochrome design.
				</p>
			</div>

			<div class="cluster footer-links-wrapper">
				<div class="flow footer-link-group">
					<h4 class="fs-step-0 footer-heading">Navigation</h4>
					<ul role="list" class="flow footer-link-list">
						<li>
							<a href="/" class="footer-link fs-step-00">Home</a>
						</li>
						<li>
							<a href="/playground" class="footer-link fs-step-00">Playground</a>
						</li>
					</ul>
				</div>

				<div class="flow footer-link-group">
					<h4 class="fs-step-0 footer-heading">Resources</h4>
					<ul role="list" class="flow footer-link-list">
						<li>
							<a href="/playground" class="footer-link fs-step-00">Design System & Playground</a>
						</li>
						<li>
							<a
								href="https://astro.build"
								target="_blank"
								rel="noopener"
								class="footer-link fs-step-00">Astro Docs</a>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="repel footer-bottom">
			<p class="fs-step-00 footer-copy">
				&copy; {new Date().getFullYear()} Studio Eien. All rights reserved.
			</p>
			<div class="cluster footer-tags">
				<span class="tag tag--sm">Astro 5</span>
				<span class="tag tag--sm">Vue 3</span>
				<span class="tag tag--sm">Pinia</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 5rem;
		padding-block: 3rem 2rem;
		border-top: 1px solid var(--border-weak);
		background: var(--background);
	}

	.footer-content {
		--space: 2.5rem;
	}

	.footer-main {
		--gutter: 2rem;
		align-items: flex-start;
	}

	.footer-brand {
		--space: 0.5rem;
		max-width: 32ch;
	}

	.footer-brand__logo-cluster {
		--gutter: 0.5rem;
		align-items: center;
	}

	.footer-brand__name {
		font-weight: 800;
	}

	.footer-brand__desc {
		opacity: 0.75;
	}

	.footer-links-wrapper {
		--gutter: 3rem;
		align-items: flex-start;
	}

	.footer-link-group {
		--space: 0.5rem;
	}

	.footer-heading {
		font-weight: 700;
	}

	.footer-link-list {
		--space: 0.25rem;
	}

	.footer-link {
		text-decoration: none;
		color: var(--text);
		opacity: 0.75;
		transition: opacity 0.2s ease;
	}

	.footer-link:hover {
		opacity: 1;
	}

	.footer-bottom {
		--gutter: 1rem;
		align-items: center;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-weak);
	}

	.footer-copy {
		opacity: 0.6;
		margin: 0;
	}

	.footer-tags {
		--gutter: 1rem;
	}

	.tag--sm {
		font-size: 0.75rem;
	}
</style>
