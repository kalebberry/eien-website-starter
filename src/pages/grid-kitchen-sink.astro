---
import Layout from '@/Layouts/DefaultLayout.astro';

const title = 'Grid Kitchen Sink — Advanced Astro Demo';
const description =
	'Deep dive into auto/explicit grids, container queries, subgrid, dense packing, a flexbox grid, and interactive controls.';
---

<style>
	:root {
		color-scheme: light dark;
	}
	.page {
		padding: clamp(1rem, 3vw, 2rem);
	}
	header.site {
		margin-block-end: 2rem;
	}
	.section {
		margin-block: 3rem;
	}
	.label {
		font-size: 0.875rem;
		opacity: 0.7;
		margin-block-end: 0.5rem;
	}
	.card {
		padding: 1rem;
		border: 1px solid hsl(0 0% 50% / 0.2);
		border-radius: 12px;
		background: hsl(0 0% 100% / 0.04);
	}
	.media {
		border-radius: 8px;
		background: hsl(210 20% 90% / 0.4);
	}

	/* Aspect‑ratio helpers */
	.ar-16-9 {
		aspect-ratio: 16/9;
	}
	.ar-21-9 {
		aspect-ratio: 21/9;
	}
	.ar-1-1 {
		aspect-ratio: 1/1;
	}
	.ar-4-3 {
		aspect-ratio: 4/3;
	}

	/* Height helpers for demos */
	.h-6 {
		height: 6rem;
	}
	.h-8 {
		height: 8rem;
	}
	.h-10 {
		height: 10rem;
	}
	.h-12 {
		height: 12rem;
	}
	.h-14 {
		height: 14rem;
	}
	.h-16 {
		height: 16rem;
	}
	.h-18 {
		height: 18rem;
	}

	/* Spacing helpers */
	.mt-1 {
		margin-top: 0.75rem;
	}
	.mb-1-5 {
		margin-bottom: 1.5rem;
	}

	/* Controls */
	.controls {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		align-items: end;
	}
	.field {
		display: grid;
		gap: 0.25rem;
	}
	.field label {
		font-size: 0.875rem;
		opacity: 0.8;
	}
	.kbd {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
			'Courier New', monospace;
		background: hsl(0 0% 100%/0.06);
		padding: 0.15rem 0.35rem;
		border-radius: 0.35rem;
		border: 1px solid hsl(0 0% 50%/0.2);
	}
	details summary {
		cursor: pointer;
	}
</style>

<Layout title={title} description={description}>
	<main class='page'>
		<header class='site'>
			<h1>{title}</h1>
			<p>{description}</p>
		</header>

		<!-- 1) GRID PLAYGROUND WITH CONTROLS -->
		<section class='section'>
			<h2>Interactive Grid Playground</h2>
			<p class='label'>
				Tweak placement, item min size, gaps, explicit columns, and dense packing. This mirrors your
				SCSS variables and attributes.
			</p>

			<form class='controls' id='gridControls' aria-label='Grid controls'>
				<div class='field'>
					<label for='placement'>
						Placement (<span class='kbd'>auto-fit</span>/<span class='kbd'>auto-fill</span>)
					</label>
					<select id='placement'>
						<option value='auto-fit' selected>auto-fit (compress empty tracks)</option>
						<option value='auto-fill'>auto-fill (preserve empty tracks)</option>
					</select>
				</div>
				<div class='field'>
					<label for='minsize'>--grid-min-item-size</label>
					<input id='minsize' type='range' min='8' max='30' step='0.5' value='18' />
					<small><span id='minsizeValue'>18</span>rem</small>
				</div>
				<div class='field'>
					<label for='gutter'>--gutter</label>
					<select id='gutter'>
						<option value='0'>0</option>
						<option value='0.5'>0.5rem</option>
						<option value='1' selected>1rem</option>
						<option value='1.5'>1.5rem</option>
					</select>
				</div>
				<div class='field'>
					<label for='cols'>Explicit <span class='kbd'>data-cols</span></label>
					<div style='display:flex; gap:.5rem; align-items:center;'>
						<input id='cols' type='number' min='1' max='12' step='1' value='4' />
						<label style='display:flex; gap:.35rem; align-items:center;'>
							<input id='forceCols' type='checkbox' />
							<span>Force explicit</span>
						</label>
					</div>
				</div>
				<div class='field'>
					<label style='display:flex; gap:.35rem; align-items:center;'>
						<input id='dense' type='checkbox' />
						<span>grid-auto-flow: <span class='kbd'>dense</span></span>
					</label>
				</div>
			</form>

			<div
				class='grid gap-4'
				id='gridPlayground'
				style='--grid-min-item-size: 18rem; --gutter: 1rem; --grid-placement: auto-fit;'
			>
				<article class='card'><div class='media ar-16-9'></div><h3>Card 1</h3></article>
				<article class='card' data-span='2'>
					<div class='media ar-21-9'></div><h3>Featured spans 2</h3>
				</article>
				<article class='card'><div class='media ar-1-1'></div><h3>Card 3</h3></article>
				<article class='card h-12'>Varied height</article>
				<article class='card'><div class='media ar-4-3'></div><h3>Card 5</h3></article>
				<article class='card h-8'>Short</article>
				<article class='card h-16'>Tall</article>
			</div>

			<details class='mt-1'>
				<summary>How this works</summary>
				<div class='card mt-1'>
					<p>
						Under the hood, your base rules apply: <span class='kbd'>
							grid-template-columns: var(--grid-cols, repeat(var(--grid-placement, auto-fit),
							minmax(var(--grid-min-item-size, 16rem), 1fr)))
						</span>. The controls write to CSS variables (and optionally set <span class='kbd'>
							data-cols
						</span>) so you can see how <strong>auto-fit vs auto-fill</strong>, minimum item width,
						gutters, and explicit columns interact.
					</p>
					<ul>
						<li>
							<strong>auto-fit</strong>: collapses empty tracks — great for variable card counts.
						</li>
						<li>
							<strong>auto-fill</strong>: keeps empty tracks — useful when you want consistent track
							math.
						</li>
						<li>
							<strong>data-cols</strong>: when forced, your Sass calculates sane <em>min-width</em> per
							column count, protecting items from becoming unusable slivers.
						</li>
						<li>
							<strong>dense</strong>: allows smaller later items to back-fill gaps caused by taller
							or spanned items. DOM order remains source of truth for a11y.
						</li>
					</ul>
				</div>
			</details>
		</section>

		<!-- 2) EXPLICIT 12-COL LAYOUT W/ SPANS -->
		<section class='section'>
			<h2>
				12‑Column System via <span class='kbd'>data-cols</span> + <span class='kbd'>data-span</span>
			</h2>
			<p class='label'>
				Treat the grid like a lightweight 12‑col system without fixed breakpoints.
			</p>
			<div class='grid gap-4' data-cols='12'>
				<div class='card' data-span='3'>3</div>
				<div class='card' data-span='3'>3</div>
				<div class='card' data-span='6'>6</div>
				<div class='card' data-span='8'>8</div>
				<div class='card' data-span='4'>4</div>
			</div>
			<details class='mt-1'>
				<summary>Deep dive</summary>
				<div class='card mt-1'>
					<p>
						The Sass computes a min size for each explicit column count using a linear interpolation
						between <span class='kbd'>$grid-min-size-start</span> and <span class='kbd'>
							$grid-min-size-end
						</span>, then compares it to the space left after gutters. This keeps the layout
						resilient across container widths and avoids media-query spaghetti.
					</p>
				</div>
			</details>
		</section>

		<!-- 3) SUBGRID ROWS -->
		<section class='section'>
			<h2>Subgrid Rows (Cross‑card Alignment)</h2>
			<p class='label'>
				Children borrow the parent rows to align headers, bodies, and footers across cards.
			</p>
			<div class='grid gap-4' style='grid-template-rows: auto 1fr auto'>
				<article class='card grid grid--subgrid-rows'>
					<header>Title 1</header>
					<div>Body grows to 1fr to align with others.</div>
					<footer>Meta</footer>
				</article>
				<article class='card grid grid--subgrid-rows'>
					<header>Longer Title 2</header>
					<div>More content… More content… More content…</div>
					<footer>Meta</footer>
				</article>
				<article class='card grid grid--subgrid-rows'>
					<header>T3</header>
					<div>Short body.</div>
					<footer>Meta</footer>
				</article>
			</div>
			<details class='mt-1'>
				<summary>Notes on support & strategy</summary>
				<div class='card mt-1'>
					<p>
						Subgrid is production‑ready in modern evergreen browsers for rows. Use it when you need
						structural alignment across repeated components (news cards, product cards) without
						hard‑coding heights. Always test the fallback (cards still work; they just don’t align
						perfectly).
					</p>
				</div>
			</details>
		</section>

		<!-- 4) SIDEBAR GRID + CONTAINER QUERIES -->
		<section class='section sidebar-grid__container'>
			<h2>Sidebar Layout with Container Queries</h2>
			<p class='label'>
				Collapses to 1 column when the <em>container</em> (not the viewport) is ≤ 48rem.
			</p>
			<div class='sidebar-grid gap-6'>
				<aside class='card'>Sidebar tools</aside>
				<main class='card'>Main content area</main>
			</div>
			<details class='mt-1'>
				<summary>Why container queries?</summary>
				<div class='card mt-1'>
					<p>
						Components should adapt to the space they actually live in. With <span class='kbd'>
							container-type: inline-size
						</span> on a wrapper, your grid can reflow sensibly inside tabs, cards, or narrow columns
						without global media queries.
					</p>
				</div>
			</details>
		</section>

		<!-- 5) FLEXBOX GRID + CONTROLS -->
		<section class='section'>
			<h2>Flexbox Grid — Row‑Wrapping Alternative</h2>
			<p class='label'>
				Ideal for simple equal‑height cards and content lists. Your mixin emits <span class='kbd'>
					flex-basis
				</span>/<span class='kbd'>min-width</span> for <span class='kbd'>data-cols</span>.
			</p>

			<form class='controls' id='flexControls' aria-label='Flexbox controls'>
				<div class='field'>
					<label for='flexCols'>data-cols</label>
					<input id='flexCols' type='number' min='1' max='12' step='1' value='4' />
				</div>
				<div class='field'>
					<label for='flexMin'>min-width (rem)</label>
					<input id='flexMin' type='range' min='8' max='30' step='0.5' value='16' />
					<small><span id='flexMinValue'>16</span>rem</small>
				</div>
				<div class='field'>
					<label for='flexBasis'>flex-basis (%)</label>
					<input id='flexBasis' type='range' min='10' max='100' step='1' value='30' />
					<small><span id='flexBasisValue'>30</span>%</small>
				</div>
				<div class='field'>
					<label for='flexGutter'>--gutter</label>
					<select id='flexGutter'>
						<option value='0'>0</option>
						<option value='0.5'>0.5rem</option>
						<option value='1' selected>1rem</option>
						<option value='1.5'>1.5rem</option>
					</select>
				</div>
			</form>

			<div
				class='flex-grid flex-grid--playground'
				id='flexPlayground'
				data-cols='4'
				style='--min-width: 16rem; --flex-basis: 30%; --gutter: 1rem;'
			>
				<div class='card'>A</div>
				<div class='card'>B</div>
				<div class='card'>C</div>
				<div class='card'>D</div>
				<div class='card'>E</div>
				<div class='card'>F</div>
			</div>

			<details class='mt-1'>
				<summary>When to choose Flex vs Grid?</summary>
				<div class='card mt-1'>
					<ul>
						<li>
							<strong>Flex</strong> for one‑dimensional flows (rows that wrap), equal‑height columns,
							and simple proportion controls.
						</li>
						<li>
							<strong>Grid</strong> for two‑dimensional control (rows + columns), spanning, and subgrid
							alignment.
						</li>
						<li>Don’t over‑nest; choose the simplest tool that fits the layout semantics.</li>
					</ul>
				</div>
			</details>
		</section>

		<!-- 6) DENSE PACKING & MASONRY -->
		<section class='section'>
			<h2>Dense Packing (Grid) vs Masonry (Columns)</h2>
			<div class='label'>Grid dense keeps DOM reading order; CSS columns reflow vertically.</div>

			<div class='grid grid--dense gap-4 mb-1-5' style='--grid-min-item-size: 14rem;'>
				<div class='card h-8'>A</div>
				<div class='card h-14'>B tall</div>
				<div class='card h-10'>C</div>
				<div class='card h-6'>D</div>
				<div class='card h-16'>E tallest</div>
				<div class='card h-8'>F</div>
				<div class='card h-8'>G</div>
			</div>

			<div class='masonry__container'>
				<div class='masonry-grid'>
					<article class='card h-12'>1</article>
					<article class='card h-6'>2</article>
					<article class='card h-18'>3</article>
					<article class='card h-10'>4</article>
					<article class='card h-14'>5</article>
					<article class='card h-8'>6</article>
				</div>
			</div>

			<details class='mt-1'>
				<summary>Trade‑offs</summary>
				<div class='card mt-1'>
					<ul>
						<li>
							<strong>Dense grid</strong>: predictable tab order; packs gaps when possible. Good for
							dashboards and card walls.
						</li>
						<li>
							<strong>Masonry columns</strong>: visually tight packing; column reading order. Great
							for image boards; add skip links for accessibility if needed.
						</li>
					</ul>
				</div>
			</details>
		</section>

		<!-- 7) ACCESSIBILITY & PERFORMANCE NOTES -->
		<section class='section'>
			<h2>Accessibility & Performance Notes</h2>
			<ul>
				<li>Maintain meaningful DOM order; spans/dense should not break keyboard navigation.</li>
				<li>
					Use semantic containers (<span class='kbd'>section</span>, <span class='kbd'>
						article
					</span>, <span class='kbd'>ul/li</span>) where appropriate.
				</li>
				<li>Prefer container queries for reusable components to avoid global media query churn.</li>
				<li>Minimize deep nesting; each grid/flex context has a layout cost.</li>
			</ul>
		</section>
	</main>

	<!-- Scripts for interactive controls (no client framework needed) -->
	<script>
		const $ = (sel) => /** @type {HTMLElement} */ (document.querySelector(sel));
		const clamp = (n, min, max) => Math.max(min, Math.min(max, n));

		// Grid controls
		const grid = $('#gridPlayground');
		const place = /** @type {HTMLSelectElement} */ ($('#placement'));
		const minsize = /** @type {HTMLInputElement} */ ($('#minsize'));
		const minsizeValue = $('#minsizeValue');
		const gutter = /** @type {HTMLSelectElement} */ ($('#gutter'));
		const dense = /** @type {HTMLInputElement} */ ($('#dense'));
		const cols = /** @type {HTMLInputElement} */ ($('#cols'));
		const forceCols = /** @type {HTMLInputElement} */ ($('#forceCols'));

		function applyGrid() {
			grid.style.setProperty('--grid-placement', place.value);
			grid.style.setProperty('--grid-min-item-size', `${minsize.value}rem`);
			grid.style.setProperty('--gutter', `${gutter.value}rem`);
			minsizeValue.textContent = minsize.value;

			grid.classList.toggle('grid--dense', dense.checked);

			if (forceCols.checked) {
				const c = clamp(Number(cols.value) || 1, 1, 12);
				grid.setAttribute('data-cols', String(c));
			} else {
				grid.removeAttribute('data-cols');
			}
		}

		['change', 'input'].forEach((evt) => {
			[place, minsize, gutter, dense, cols, forceCols].forEach((el) =>
				el.addEventListener(evt, applyGrid)
			);
		});
		applyGrid();

		// Flexbox controls
		const flex = $('#flexPlayground');
		const flexCols = /** @type {HTMLInputElement} */ ($('#flexCols'));
		const flexMin = /** @type {HTMLInputElement} */ ($('#flexMin'));
		const flexMinValue = $('#flexMinValue');
		const flexBasis = /** @type {HTMLInputElement} */ ($('#flexBasis'));
		const flexBasisValue = $('#flexBasisValue');
		const flexGutter = /** @type {HTMLSelectElement} */ ($('#flexGutter'));

		function applyFlex() {
			const c = clamp(Number(flexCols.value) || 1, 1, 12);
			flex.setAttribute('data-cols', String(c));
			flex.style.setProperty('--min-width', `${flexMin.value}rem`);
			flex.style.setProperty('--flex-basis', `${flexBasis.value}%`);
			flex.style.setProperty('--gutter', `${flexGutter.value}rem`);
			flexMinValue.textContent = flexMin.value;
			flexBasisValue.textContent = flexBasis.value;
		}

		['change', 'input'].forEach((evt) => {
			[flexCols, flexMin, flexBasis, flexGutter].forEach((el) =>
				el.addEventListener(evt, applyFlex)
			);
		});
		applyFlex();
	</script>
</Layout>
