---
import Navigation from '@/components/Navigation.astro';
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<title>Design System Demo</title>

		<link rel='preconnect' href='https://fonts.googleapis.com' />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link
			href='https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300&family=PT+Serif:wght@400;700&display=swap'
			rel='stylesheet'
		/>
		<link rel='stylesheet' href='/src/styles/main.css' />
		<link rel='stylesheet' href='/src/styles/grid-demo.css' />
	</head>
	<body>
		<Navigation />
		<div class='wrap'>
			<header>
				<h1>Design System</h1>
				<p class='lead'>
					A live demonstration of the core design tokens and components for this application.
				</p>
			</header>

			<main class='flow-large'>
				<!-- Typography -->
				<section class='flow-large'>
					<header>
						<h2 class='section-title'>Typography &amp; Font Scaling</h2>
						<p>
							The following text samples demonstrate the fluid typography system. Font sizes scale
							automatically based on viewport width, using CSS <code>clamp()</code>.
						</p>
					</header>

					<div class='card flow-large'>
						<div style='font-family: var(--ff-pt-serif);'>
							<h3 class='fs-step-5' style='font-weight: 700'>Display Heading (PT Serif, Bold)</h3>
							<p class='fs-step-0'>
								Used for major page titles and impactful statements. Class:
								<code>.fs-step-5</code>
							</p>
						</div>

						<div style='font-family: var(--ff-fira-sans);'>
							<h4 class='fs-step-3' style='font-weight: 300'>Section Heading (Fira Sans, Light)</h4>
							<p class='fs-step-0'>
								Used for section titles like the ones on this page. Class:
								<code>.fs-step-3</code>
							</p>
						</div>

						<div style='font-family: var(--ff-fira-sans);'>
							<p class='fs-step-1'>
								<strong>Lead Paragraph (Fira Sans, Step 1):</strong> This is for introductory paragraphs
								that need a bit more emphasis than standard body text. It provides a gentle entry point
								into a section of content.
							</p>
						</div>

						<div>
							<p class='fs-step-0'>
								<strong>Body Text (Fira Sans, Step 0):</strong> This is the default size for all standard
								text content. It's designed for maximum readability for long-form reading. The quick brown
								fox jumps over the lazy dog.
							</p>
						</div>

						<div>
							<p class='fs-step-00'>
								<small>
									<strong>Small/Muted Text (Fira Sans, Step -1):</strong> Used for captions, hints, and
									other secondary information that shouldn't compete with the main content.
								</small>
							</p>
						</div>
					</div>
				</section>

				<!-- Colors -->
				<section class='flow-large'>
					<header>
						<h2 class='section-title'>Color Palette</h2>
						<p>
							Core color tokens for light and dark themes. These are defined as CSS custom
							properties.
						</p>
					</header>

					<section class='grid-container'>
						<!-- Use grid with auto-fit via class and explicit min size -->
						<div class='grid grid--fit gap-4' style='--grid-min-item-size: 10rem;'>
							<div class='card'>
								<div
									style='width: 100%; height: 4rem; background: var(--background); border: 1px solid var(--border);'
								>
								</div>
								<code>--background</code>
							</div>
							<div class='card'>
								<div style='width: 100%; height: 4rem; background: var(--border-weak);'></div>
								<code>--border-weak</code>
							</div>
							<div class='card'>
								<div style='width: 100%; height: 4rem; background: var(--text);'></div>
								<code>--text</code>
							</div>
							<div class='card'>
								<div style='width: 100%; height: 4rem; background: var(--muted);'></div>
								<code>--muted</code>
							</div>
						</div>

						<!-- Spacing -->
						<section class='flow-large'>
							<h2 class='section-title'>Spacing</h2>
							<p>
								Spacing is managed via a numeric scale (8, 12, 16, 24, 32, 48, 64, 96) defined in
								<code>space-sizes.css</code>. These power utility classes for margins and padding.
							</p>

							<section class='grid-container'>
								<div class='grid grid--fit gap-4' style='--grid-min-item-size: 10rem'>
									<div class='card'>
										<div style='width:100%;height:0.5rem;background:var(--text);'></div>
										<code>Step 8</code> (0.5rem)
									</div>
									<div class='card'>
										<div style='width:100%;height:1rem;background:var(--text);'></div>
										<code>Step 16</code> (1rem)
									</div>
									<div class='card'>
										<div style='width:100%;height:2rem;background:var(--text);'></div>
										<code>Step 32</code> (2rem)
									</div>
									<div class='card'>
										<div style='width:100%;height:4rem;background:var(--text);'></div>
										<code>Step 64</code> (4rem)
									</div>
								</div>
							</section>
						</section>

						<!-- Layout Patterns -->
						<section class='flow-large'>
							<h2 class='section-title'>Layout Patterns</h2>

							<!-- Cluster -->
							<div class='flow'>
								<h4>Cluster</h4>
								<p>
									The Cluster layout distributes items with consistent spacing (gaps), wrapping
									automatically. Ideal for tags, buttons, or metadata.
								</p>
								<p class='fs-step-00' style='color: var(--muted); font-style: italic;'>
									Note: Uses <code>flex-wrap: wrap</code> and <code>
										justify-content: space-between
									</code>
									via the <code>.repel</code> logic or standard flex for clusters.
								</p>
								<div class='card'>
									<div class='cluster' style='--gutter: 0.5rem;'>
										<span class='tag'>Design</span>
										<span class='tag'>Development</span>
										<span class='tag'>Astro</span>
										<span class='tag'>SCSS</span>
										<span class='tag'>Grid</span>
										<span class='tag'>Flexbox</span>
										<span class='tag'>Container Queries</span>
									</div>
								</div>
							</div>
						</section>

						<!-- Grid System -->
						<section class='flow-large'>
							<h2 class='section-title'>Grid System</h2>
							<p>
								The auto-grid system uses CSS Grid with <code>auto-fit</code> or fixed column presets
								to create responsive layouts without media queries.
							</p>

							<div class='flow-large'>
								<h4>Column Count Presets</h4>
								<p>
									Use <code>data-cols</code> for quick, breakpoint-free columns that adapt to space.
								</p>
								<p class='fs-step-00' style='color: var(--muted); font-style: italic;'>
									Note: Dynamically calculates <code>--grid-min-item-size</code> using Sass math to target
									a specific column count while remaining fluid.
								</p>

								<section class='grid-container'>
									<div class='grid gap-4' data-cols='4'>
										<div class='card'>4-col</div>
										<div class='card'>item</div>
										<div class='card'>item</div>
										<div class='card'>item</div>
									</div>
								</section>

								<h4>Auto-fit Grid</h4>
								<p>
									This grid uses <code>auto-fit</code> with a minimum item size of <code>
										12rem
									</code>. Items wrap and grow to fill available space.
								</p>
								<p class='fs-step-00' style='color: var(--muted); font-style: italic;'>
									Note: Uses <code>repeat(auto-fit, minmax(size, 1fr))</code>.
									<code>auto-fit</code> collapses empty tracks to allow items to expand.
								</p>

								<section class='grid-container'>
									<div class='grid grid--fit gap-4' style='--grid-min-item-size: 12rem;'>
										<div class='card'>Item A</div>
										<div class='card'>Item B</div>
										<div class='card'>Item C</div>
										<div class='card'>Item D</div>
										<div class='card'>Item E</div>
									</div>
								</section>

								<h4>Dense Packing &amp; Spans</h4>
								<p>
									Use <code>.grid--dense</code> and item spans (e.g., <code>data-span="2"</code>) to
									create masonry-style layouts that fill empty gaps.
								</p>
								<p class='fs-step-00' style='color: var(--muted); font-style: italic;'>
									Note: <code>grid-auto-flow: dense</code> tells the browser to backfill empty holes in
									the grid if smaller items appear later in the DOM.
								</p>

								<section class='grid-container'>
									<div class='grid grid--dense gap-4' data-cols='4'>
										<article class='card' data-span='2'>
											<h3>Wide Item</h3>
											<p>Spans 2 columns.</p>
										</article>
										<article class='card'><h3>Normal</h3></article>
										<article class='card' data-row-span='2'>
											<h3>Tall Item</h3>
											<p>Spans 2 rows.</p>
										</article>
										<article class='card'><h3>Normal</h3></article>
										<article class='card'><h3>Normal</h3></article>
									</div>
								</section>

								<h4>Subgrid Alignment</h4>
								<p>
									Use <code>.subgrid-card</code> to allow nested elements to align to the parent grid's
									tracks. Perfect for consistent internal card alignment.
								</p>
								<p class='fs-step-00' style='color: var(--muted); font-style: italic;'>
									Note: Requires <code>grid-template-columns: subgrid</code>. Nested items snap to
									the same vertical lines as the top-level grid.
								</p>

								<section class='grid-container'>
									<div class='grid gap-4' data-cols='3'>
										<div class='card'>
											<h3>Standard</h3>
											<p>Comparison item.</p>
										</div>
										<div class='card subgrid-card' data-span='2'>
											<div class='card' style='background: var(--border-weak)'>
												<h4>Sub-item 1</h4>
												<p>Aligns to Col 2</p>
											</div>
											<div class='card' style='background: var(--border-weak)'>
												<h4>Sub-item 2</h4>
												<p>Aligns to Col 3</p>
											</div>
										</div>
									</div>
								</section>

								<h4>The Reel (Horizontal Scroll)</h4>
								<p>
									Perfect for mobile-friendly carousels. Items don't wrap; they overflow
									horizontally with scroll-snapping.
								</p>
								<p class='fs-step-00' style='color: var(--muted); font-style: italic;'>
									Note: Uses <code>overflow-x: auto</code> and <code>
										scroll-snap-type: x mandatory
									</code>. Width is controlled via <code>--reel-item-width</code>.
								</p>
								<section class='grid-container'>
									<div class='reel gap-4'>
										<div class='card'>Item 1</div>
										<div class='card'>Item 2</div>
										<div class='card'>Item 3</div>
										<div class='card'>Item 4</div>
										<div class='card'>Item 5</div>
									</div>
								</section>

								<h4>The Frame (Aspect Ratio)</h4>
								<p>
									Forces content (like Picsum images) into specific ratios to keep the grid unified.
								</p>
								<p class='fs-step-00' style='color: var(--muted); font-style: italic;'>
									Note: Leverages the CSS <code>aspect-ratio</code> property. Content is centered and
									cropped using <code>object-fit: cover</code>.
								</p>
								<section class='grid gap-4' data-cols='3'>
									<div class='frame card' style='--n: 16; --d: 9;'>
										<img src='https://picsum.photos/id/10/800/450' alt='16:9 Frame' />
									</div>
									<div class='frame card' style='--n: 1; --d: 1;'>
										<img src='https://picsum.photos/id/20/400/400' alt='1:1 Frame' />
									</div>
									<div class='frame card' style='--n: 4; --d: 5;'>
										<img src='https://picsum.photos/id/30/400/500' alt='4:5 Frame' />
									</div>
								</section>

								<h4>Masonry Grid</h4>
								<p>
									A CSS-only masonry layout using <code>column-count</code>. It automatically
									adjusts columns via Container Queries.
								</p>
								<p class='fs-step-00' style='color: var(--muted); font-style: italic;'>
									Note: Uses <code>break-inside: avoid</code> on children to prevent cards from splitting
									across columns. Columns reflow at 40rem and 70rem.
								</p>

								<section class='masonry__container'>
									<div class='masonry-grid gap-4'>
										<div class='card' style='height: 10rem;'>Short</div>
										<div class='card' style='height: 18rem;'>Tall</div>
										<div class='card' style='height: 12rem;'>Medium</div>
										<div class='card' style='height: 15rem;'>Medium-Tall</div>
										<div class='card' style='height: 9rem;'>Extra Short</div>
										<div class='card' style='height: 20rem;'>Extra Tall</div>
									</div>
								</section>

								<h4>Sidebar Layout</h4>
								<p>
									An explicit two-column grid for main content and a sidebar that gracefully stacks
									on smaller screens.
								</p>

								<section class='sidebar-grid__container'>
									<div class='sidebar-grid gap-6'>
										<article class='card'>
											<h3>Main Content Area</h3>
											<p>This area is wider and flexible.</p>
										</article>
										<aside class='card'>
											<h3>Sidebar</h3>
											<p>This area has a fixed base width.</p>
										</aside>
									</div>
								</section>
							</div>
						</section>

						<!-- Debug Tools Section -->
						<section class='flow-large'>
							<h2 class='section-title'>Debug Tools</h2>
							<p>
								The system includes a <strong>Grid Debug Overlay</strong>. Add
								<code>data-grid-overlay="true"</code> to any grid to visualize the tracks.
							</p>

							<div class='flow'>
								<button class='btn btn--sm' id='toggle-debug'>Toggle Debug Overlay</button>
								<div
									id='debug-grid-demo'
									class='grid gap-4'
									data-cols='4'
									data-grid-overlay='false'
								>
									<div class='card'>Track 1</div>
									<div class='card'>Track 2</div>
									<div class='card'>Track 3</div>
									<div class='card'>Track 4</div>
								</div>
							</div>
						</section>
					</section>
				</section>
			</main>
		</div>
	</body>
</html>
