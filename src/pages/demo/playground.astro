---
import DefaultLayout from "@/Layouts/DefaultLayout.astro";
---

<DefaultLayout title="Layout Playground — Eien Framework" description="Interactive CSS Grid and Flexbox layout engine playground and demonstration.">
  <main class="flow-large" style="--space: 3rem;">
    <!-- PAGE HEADER -->
    <section class="container flow" style="--space: 1rem;">
      <div class="repel" style="--gutter: 1rem; align-items: flex-end;">
        <div>
          <span class="tag margin-block-end-8">Interactive Tool</span>
          <h1 class="fs-step-7" style="margin: 0;">Layout Playground</h1>
          <p class="fs-step-1 lead" style="margin-block-start: 0.5rem;">
            Test and tweak the Eien layout engines in real time. Switch between CSS Grid and Flexbox, adjust track math, and explore responsive layout compositions.
          </p>
        </div>
        <div class="cluster" style="--gutter: 0.5rem;">
          <a href="/demo/starter" class="btn btn--sm btn--ghost">View Starter Page →</a>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE PLAYGROUND CONTROL PANEL -->
    <section class="container flow-large">
      <div class="card--bw panel-controls flow" style="padding: 1.75rem; border-radius: 0.75rem;">
        <div class="repel" style="--gutter: 1rem; align-items: center; border-bottom: 1px solid var(--border-weak); padding-bottom: 1rem;">
          <h2 class="fs-step-2" style="margin: 0;">Engine & Layout Controls</h2>
          
          <!-- Engine Selector Tabs -->
          <div class="cluster" style="--gutter: 0.5rem;" role="tablist" aria-label="Layout Engine Selector">
            <button class="btn btn--sm tab-btn active" id="tab-grid" role="tab" aria-selected="true">
              CSS Grid (.grid)
            </button>
            <button class="btn btn--sm btn--ghost tab-btn" id="tab-flex" role="tab" aria-selected="false">
              Flexbox (.flex-grid)
            </button>
          </div>
        </div>

        <div class="controls-grid grid" data-cols="4" style="--gutter: 1.5rem; --grid-min-item-size: 14rem;">
          <!-- Track Placement Option (Grid mode only) -->
          <div class="control-group flow" style="--space: 0.35rem;" id="placement-group">
            <label for="placement" class="fs-step-00" style="font-weight: 700;">Track Placement</label>
            <select id="placement" class="input-select" aria-label="Grid Placement">
              <option value="auto-fit" selected>auto-fit (collapse empty tracks)</option>
              <option value="auto-fill">auto-fill (preserve phantom tracks)</option>
            </select>
            <span class="fs-step-00" style="opacity: 0.7;">Controls extra space behavior.</span>
          </div>

          <!-- Gutter Slider -->
          <div class="control-group flow" style="--space: 0.35rem;">
            <div class="repel">
              <label for="gutter" class="fs-step-00" style="font-weight: 700;">Gutter (gap)</label>
              <span id="gutterOut" class="fs-step-00 code-badge">16px</span>
            </div>
            <input id="gutter" type="range" min="0" max="48" step="4" value="16" class="range-slider" />
            <span class="fs-step-00" style="opacity: 0.7;">CSS <code>gap</code> spacing.</span>
          </div>

          <!-- Min Item Size Slider -->
          <div class="control-group flow" style="--space: 0.35rem;">
            <div class="repel">
              <label for="minsize" class="fs-step-00" style="font-weight: 700;">Min Item Size</label>
              <span id="minOut" class="fs-step-00 code-badge">240px</span>
            </div>
            <input id="minsize" type="range" min="140" max="420" step="10" value="240" class="range-slider" />
            <span class="fs-step-00" style="opacity: 0.7;">Minimum card width.</span>
          </div>

          <!-- Container Width Slider -->
          <div class="control-group flow" style="--space: 0.35rem;">
            <div class="repel">
              <label for="containerWidth" class="fs-step-00" style="font-weight: 700;">Container Width</label>
              <span id="widthOut" class="fs-step-00 code-badge">100%</span>
            </div>
            <input id="containerWidth" type="range" min="360" max="1200" step="20" value="1200" class="range-slider" />
            <span class="fs-step-00" style="opacity: 0.7;">Simulate screen resize.</span>
          </div>
        </div>
      </div>

      <!-- LIVE PLAYGROUND PREVIEW CONTAINER -->
      <div id="demoFrame" class="demo-frame" style="max-width: 100%; transition: max-width 0.2s ease;">
        <header class="margin-block-end-16">
          <span id="engineBadge" class="tag">Active Engine: CSS Grid (.grid)</span>
        </header>
        
        <div id="playgroundGrid" class="grid grid--fit gap-4" style="--gutter: 1rem; --grid-min-item-size: 15rem;">
          {Array.from({ length: 8 }).map((_, i) => (
            <article class="card--bw padding-16 flow" style="--space: 0.5rem; min-height: 120px;">
              <div class="repel">
                <h3 class="fs-step-1" style="margin: 0;">Card {i + 1}</h3>
                <span class="fs-step-00" style="opacity: 0.6;">#{i + 1}</span>
              </div>
              <p class="fs-step-0" style="opacity: 0.8; margin: 0;">
                {i === 2 ? "Dynamic fluid layout responding seamlessly without media query hacks." : i === 5 ? "Intrinsic design pattern scaling content gracefully." : "Fluid design system token item."}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- COLUMN COUNT PRESETS -->
    <section class="container flow-large">
      <header class="flow" style="--space: 0.5rem;">
        <h2 class="fs-step-5">Column Count Presets (<code>data-cols</code>)</h2>
        <p class="fs-step-0 lead">
          Apply <code>data-cols="N"</code> for rapid, breakpoint-free responsive column layouts.
        </p>
      </header>

      <div class="flow-large">
        <!-- 2 Columns -->
        <div class="flow" style="--space: 0.5rem;">
          <h3 class="fs-step-1">2 Columns (<code>data-cols="2"</code>)</h3>
          <div class="grid gap-4" data-cols="2">
            <div class="card--bw padding-16"><h4 class="fs-step-0">Column 1</h4><p class="fs-step-00">50% baseline width</p></div>
            <div class="card--bw padding-16"><h4 class="fs-step-0">Column 2</h4><p class="fs-step-00">50% baseline width</p></div>
          </div>
        </div>

        <!-- 3 Columns -->
        <div class="flow" style="--space: 0.5rem;">
          <h3 class="fs-step-1">3 Columns (<code>data-cols="3"</code>)</h3>
          <div class="grid gap-4" data-cols="3">
            <div class="card--bw padding-16"><h4 class="fs-step-0">Col 1</h4><p class="fs-step-00">Equal distribution</p></div>
            <div class="card--bw padding-16"><h4 class="fs-step-0">Col 2</h4><p class="fs-step-00">Equal distribution</p></div>
            <div class="card--bw padding-16"><h4 class="fs-step-0">Col 3</h4><p class="fs-step-00">Equal distribution</p></div>
          </div>
        </div>

        <!-- 4 Columns -->
        <div class="flow" style="--space: 0.5rem;">
          <h3 class="fs-step-1">4 Columns (<code>data-cols="4"</code>)</h3>
          <div class="grid gap-4" data-cols="4">
            <div class="card--bw padding-16"><h4 class="fs-step-0">1</h4></div>
            <div class="card--bw padding-16"><h4 class="fs-step-0">2</h4></div>
            <div class="card--bw padding-16"><h4 class="fs-step-0">3</h4></div>
            <div class="card--bw padding-16"><h4 class="fs-step-0">4</h4></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ITEM SPANNING & DENSE PACKING -->
    <section class="container flow-large">
      <header class="flow" style="--space: 0.5rem;">
        <h2 class="fs-step-5">Item Spans & Dense Packing</h2>
        <p class="fs-step-0 lead">
          Use <code>data-span="N"</code> and <code>.grid--dense</code> to build masonry-style layouts that backfill space efficiently.
        </p>
      </header>

      <div class="grid grid--dense gap-4" data-cols="4">
        <article class="card--bw padding-16 flow" data-span="2" style="--space: 0.5rem;">
          <h3 class="fs-step-1">Wide Item (Spans 2)</h3>
          <p class="fs-step-0">Takes up 2 column tracks via <code>data-span="2"</code>.</p>
        </article>
        <article class="card--bw padding-16"><h3 class="fs-step-1">Standard</h3><p class="fs-step-0">1 column</p></article>
        <article class="card--bw padding-16"><h3 class="fs-step-1">Standard</h3><p class="fs-step-0">1 column</p></article>
        <article class="card--bw padding-16 flow" data-span="3" style="--space: 0.5rem;">
          <h3 class="fs-step-1">Featured Item (Spans 3)</h3>
          <p class="fs-step-0">Takes up 3 column tracks across wider viewports.</p>
        </article>
        <article class="card--bw padding-16"><h3 class="fs-step-1">Standard</h3><p class="fs-step-0">1 column</p></article>
      </div>
    </section>

    <!-- LAYOUT COMPOSITIONS -->
    <section class="container flow-large">
      <header class="flow" style="--space: 0.5rem;">
        <h2 class="fs-step-5">Specialized Layout Compositions</h2>
        <p class="fs-step-0 lead">
          Pre-packaged intrinsic layouts for sidebar content, carousels, subgrids, and aspect frames.
        </p>
      </header>

      <!-- Sidebar Composition -->
      <div class="flow-large">
        <h3 class="fs-step-2">1. Sidebar Layout (Flexible Main + Fixed Sidebar)</h3>
        <div class="sidebar" style="--gutter: 1rem; --sidebar-target-width: 18rem; --sidebar-content-min-width: 55%;">
          <aside class="card--bw padding-16 flow" style="--space: 0.5rem;">
            <h4 class="fs-step-1">Sidebar Area</h4>
            <p class="fs-step-0">Fixed target width that wraps underneath main content on mobile screens.</p>
          </aside>
          <div class="card--bw padding-16 flow" style="--space: 0.5rem;">
            <h4 class="fs-step-1">Main Content Area</h4>
            <p class="fs-step-0">Grows dynamically to fill remaining inline room.</p>
          </div>
        </div>
      </div>

      <!-- The Reel (Horizontal Scroll) -->
      <div class="flow-large">
        <h3 class="fs-step-2">2. The Reel (Horizontal Scroll Carousel)</h3>
        <div class="reel" style="--gutter: 1rem;">
          {Array.from({ length: 6 }).map((_, i) => (
            <div class="card--bw padding-16 flow" style="width: 18rem; flex-shrink: 0; --space: 0.5rem;">
              <h4 class="fs-step-1">Reel Item {i + 1}</h4>
              <p class="fs-step-0">Scroll horizontally with native CSS scroll-snapping.</p>
            </div>
          ))}
        </div>
      </div>

      <!-- The Frame (Aspect Ratio) -->
      <div class="flow-large">
        <h3 class="fs-step-2">3. The Frame (Aspect Ratio Control)</h3>
        <div class="grid gap-4" data-cols="3">
          <div class="card--bw padding-16 flow" style="--space: 0.5rem;">
            <div class="frame" style="--n: 1; --d: 1; border-radius: 0.5rem; overflow: hidden; background: var(--muted);">
              <img src="https://picsum.photos/id/1015/600/600" alt="Square example" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <p class="fs-step-00" style="text-align: center;">Square (1:1 Ratio)</p>
          </div>

          <div class="card--bw padding-16 flow" style="--space: 0.5rem;">
            <div class="frame" style="--n: 16; --d: 9; border-radius: 0.5rem; overflow: hidden; background: var(--muted);">
              <img src="https://picsum.photos/id/1018/1600/900" alt="Widescreen example" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <p class="fs-step-00" style="text-align: center;">Video (16:9 Ratio)</p>
          </div>

          <div class="card--bw padding-16 flow" style="--space: 0.5rem;">
            <div class="frame" style="--n: 4; --d: 5; border-radius: 0.5rem; overflow: hidden; background: var(--muted);">
              <img src="https://picsum.photos/id/1025/800/1000" alt="Portrait example" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <p class="fs-step-00" style="text-align: center;">Portrait (4:5 Ratio)</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .panel-controls {
      background: var(--background);
      border: 1px solid var(--border-weak);
    }

    .tab-btn.active {
      background: var(--text);
      color: var(--background);
      border-color: var(--text);
    }

    .input-select {
      width: 100%;
      padding: 0.5rem 0.75rem;
      border-radius: 0.375rem;
      border: 1px solid var(--border-weak);
      background: var(--background);
      color: var(--text);
      font-family: inherit;
      font-size: 0.875rem;
    }

    .range-slider {
      width: 100%;
      accent-color: var(--text);
      cursor: pointer;
    }

    .code-badge {
      font-family: monospace;
      padding: 0.15rem 0.4rem;
      background: rgba(125, 125, 125, 0.15);
      border-radius: 0.25rem;
    }

    .demo-frame {
      padding: 1.5rem;
      border: 1px dashed var(--border-weak);
      border-radius: 0.75rem;
      margin-inline: auto;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const playgroundGrid = document.getElementById("playgroundGrid");
      const demoFrame = document.getElementById("demoFrame");
      const engineBadge = document.getElementById("engineBadge");

      const tabGrid = document.getElementById("tab-grid");
      const tabFlex = document.getElementById("tab-flex");
      const placementGroup = document.getElementById("placement-group");

      const placement = document.getElementById("placement") as HTMLSelectElement;
      const gutter = document.getElementById("gutter") as HTMLInputElement;
      const minsize = document.getElementById("minsize") as HTMLInputElement;
      const containerWidth = document.getElementById("containerWidth") as HTMLInputElement;

      const gutterOut = document.getElementById("gutterOut");
      const minOut = document.getElementById("minOut");
      const widthOut = document.getElementById("widthOut");

      let currentEngine: "grid" | "flex" = "grid";

      function updateEngine(engine: "grid" | "flex") {
        currentEngine = engine;
        if (engine === "grid") {
          tabGrid?.classList.add("active");
          tabGrid?.setAttribute("aria-selected", "true");
          tabFlex?.classList.remove("active");
          tabFlex?.setAttribute("aria-selected", "false");
          
          if (playgroundGrid) {
            playgroundGrid.className = "grid grid--fit gap-4";
          }
          if (placementGroup) placementGroup.style.display = "flex";
          if (engineBadge) engineBadge.textContent = "Active Engine: CSS Grid (.grid)";
        } else {
          tabFlex?.classList.add("active");
          tabFlex?.setAttribute("aria-selected", "true");
          tabGrid?.classList.remove("active");
          tabGrid?.setAttribute("aria-selected", "false");

          if (playgroundGrid) {
            playgroundGrid.className = "flex-grid gap-4";
          }
          if (placementGroup) placementGroup.style.display = "none";
          if (engineBadge) engineBadge.textContent = "Active Engine: Flexbox Engine (.flex-grid)";
        }
      }

      tabGrid?.addEventListener("click", () => updateEngine("grid"));
      tabFlex?.addEventListener("click", () => updateEngine("flex"));

      placement?.addEventListener("change", (e) => {
        const val = (e.target as HTMLSelectElement).value;
        if (playgroundGrid) {
          playgroundGrid.classList.toggle("grid--fit", val === "auto-fit");
          playgroundGrid.classList.toggle("grid--fill", val === "auto-fill");
        }
      });

      gutter?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (playgroundGrid) playgroundGrid.style.setProperty("--gutter", `${val}px`);
        if (gutterOut) gutterOut.textContent = `${val}px`;
      });

      minsize?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (playgroundGrid) playgroundGrid.style.setProperty("--grid-min-item-size", `${val}px`);
        if (minOut) minOut.textContent = `${val}px`;
      });

      containerWidth?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (demoFrame) demoFrame.style.maxWidth = `${val}px`;
        if (widthOut) widthOut.textContent = `${val}px`;
      });
    });
  </script>
</DefaultLayout>
